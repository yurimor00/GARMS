# Copiar para .env e preencher. Nunca fazer commit do .env.

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_SPA_CLIENT_ID=
# Só na Account PAPI (machine-to-machine, SEGREDO)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- Comunicação interna ---
INTERNAL_API_KEY=

# --- MySQL ---
# Azure: <servidor>.mysql.database.azure.com (TLS obrigatório)
# Cada serviço usa o seu utilizador: garms_user_sapi, garms_wardrobe_sapi ou garms_reco
# (ver database/users/utilizadores_servicos.sql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_SSL=true
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB_PRINCIPAL=dw_principal
MYSQL_DB_RECO=dw_reco

# --- Redis ---
# Password obrigatória (SEGREDO). Só escuta em 127.0.0.1; dentro do compose o host é "redis"
REDIS_PASSWORD=
REDIS_PORT=6379
# Painel Redis Insight (http://localhost:5540)
REDISINSIGHT_PORT=5540
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0

# --- RabbitMQ ---
# Utilizador criado no primeiro arranque do container (o guest não aceita ligações de fora)
RABBITMQ_USER=garms
RABBITMQ_PASSWORD=
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# Os serviços usam o vhost "garms" (no fim do URL); dentro do compose o host é "rabbitmq"
RABBITMQ_URL=amqp://garms:<RABBITMQ_PASSWORD>@localhost:5672/garms
RABBITMQ_EXCHANGE=dw.events

# --- Supabase Storage (só na Wardrobe SAPI) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# --- Meteorologia ---
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_ALERT_WEBHOOK_SECRET=

# --- Cloudflare Tunnel (SEGREDO) ---
# Token do túnel (Zero Trust → Networks → Tunnels → o túnel → token do conector)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Endereços internos (local) ---
USER_SAPI_URL=http://localhost:3001/api/v1
WARDROBE_SAPI_URL=http://localhost:3002/api/v1
WEATHER_SAPI_URL=http://localhost:3003/api/v1
ACCOUNT_PAPI_URL=http://localhost:3004/api/v1
PLANNER_PAPI_URL=http://localhost:3005/api/v1
WARDROBE_PAPI_URL=http://localhost:3006/api/v1
RECOMMENDATION_URL=http://localhost:3007/api/v1
